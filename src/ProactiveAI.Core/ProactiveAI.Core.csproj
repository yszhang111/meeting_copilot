<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ProactiveAI.Core</RootNamespace>
    <AssemblyName>ProactiveAI.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime prompts and schemas are versioned resources, separate from orchestration code. -->
    <EmbeddedResource Include="Prompts\*.*" LogicalName="ProactiveAI.Prompts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProactiveAI.Tests" />
  </ItemGroup>

</Project>
