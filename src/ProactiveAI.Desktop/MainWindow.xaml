<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ProactiveAI.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ProactiveAI.Desktop.Views"
    Title="Proactive AI">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40" Padding="16,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0" />
                            <GradientStop Color="#7C3AED" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="White" />
                </Border>
                <TextBlock Text="Proactive AI" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleState" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        ItemInvoked="Nav_ItemInvoked" IsPaneOpen="False" OpenPaneLength="220">
            <!-- The live session page has no entry of its own: it is reached through Home (New session, or Return to session). -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <views:HomeView x:Name="HomePage" />
                <views:SetupView x:Name="SetupPage" Visibility="Collapsed" />
                <views:LiveSessionView x:Name="LiveView" Visibility="Collapsed" />
                <views:SessionDetailView x:Name="DetailPage" Visibility="Collapsed" />
                <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
