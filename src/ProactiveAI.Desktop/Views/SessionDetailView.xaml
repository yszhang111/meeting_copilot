<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProactiveAI.Desktop.Views.SessionDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ProactiveAI.Desktop.ViewModels">

    <Grid Padding="20,8,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.BackCommand}" VerticalAlignment="Center" AutomationProperties.Name="Back to Home">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="Home" /></StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.DateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="Consolas" />
                    <TextBlock Text="{x:Bind ViewModel.MetaText, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                <Button Command="{x:Bind ViewModel.CopyTranscriptCommand}" AutomationProperties.Name="Copy transcript and answers">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="Copy all" /></StackPanel>
                </Button>
                <Button AutomationProperties.Name="Delete this session">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Delete" /></StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="DeleteFlyout">
                            <StackPanel Spacing="10" MaxWidth="280">
                                <TextBlock TextWrapping="Wrap" Text="Delete this session's saved transcript and answers? This cannot be undone." />
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Delete" Click="ConfirmDelete_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <!-- Transcript -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Transcript" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" Margin="16,10,16,6" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None" Padding="4,0,4,8" AutomationProperties.Name="Saved transcript">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,0,12,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryLineViewModel">
                                <Grid Padding="0,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionMutedStyle}" FontFamily="Consolas" Margin="0,3,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Speaker}" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Opacity="{x:Bind TextOpacity}" IsTextSelectionEnabled="True"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No transcript lines were saved."
                               Visibility="{x:Bind ViewModel.NoLinesVisibility, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- Answers -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Answers and insights" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" Margin="16,10,16,6" />
                    <ScrollViewer Grid.Row="1" Padding="16,0,16,12">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryCardViewModel">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="12,10">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind KindText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionMutedStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind DirectPosition}" Visibility="{x:Bind DirectVisibility}" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind Body}" Visibility="{x:Bind BodyVisibility}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <Border Visibility="{x:Bind FilledInVisibility}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="10,8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="AI filled in these details (not from your notes or what you said)" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind FilledInText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                            </Border>
                                            <Expander Header="Supporting points" Visibility="{x:Bind SupportingVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{x:Bind SupportingText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Expander>
                                            <Expander Header="Assumptions and limits" Visibility="{x:Bind LimitsVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{x:Bind LimitsText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Expander>
                                            <Expander Header="Likely follow-ups" Visibility="{x:Bind FollowupsVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{x:Bind FollowupsText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Expander>
                                            <Expander Header="Facts that must not be made up — add them yourself" Visibility="{x:Bind MissingVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{x:Bind MissingText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Text="No answers or insights in this session." Visibility="{x:Bind ViewModel.NoCardsVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
