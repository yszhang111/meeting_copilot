<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProactiveAI.Desktop.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProactiveAI.Desktop.Views"
    xmlns:vm="using:ProactiveAI.Desktop.ViewModels">

    <Grid Padding="32,16,32,24" RowSpacing="20" MaxWidth="1000" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Welcome to Proactive AI" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource CaptionMutedStyle}" FontSize="14"
                       Text="Start a new session, or open a previous one to review what was said and the answers you got." />
        </StackPanel>

        <!-- New session / return to the running session -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="10" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0" />
                            <GradientStop Color="#7C3AED" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE720;" FontSize="22" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="New session" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource CaptionMutedStyle}"
                               Text="Pick the scenario, check your microphone and speakers, then start listening." />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.SessionNoteVisibility, Mode=OneWay}" Text="{x:Bind ViewModel.SessionNote, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ReturnToSessionCommand}" Visibility="{x:Bind ViewModel.ReturnVisibility, Mode=OneWay}"
                            AutomationProperties.Name="Return to the current session">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Return to session" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewSessionCommand}" IsEnabled="{x:Bind ViewModel.CanStartNew, Mode=OneWay}"
                            AutomationProperties.Name="Start a new session">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New session" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- History -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Previous sessions" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" HorizontalAlignment="Right" />
            </Grid>
            <ListView x:Name="SessionList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sessions}" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="SessionList_ItemClick" AutomationProperties.Name="Previous sessions">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionSummaryViewModel">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,10" AutomationProperties.Name="{x:Bind Title}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind DateText}" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="Consolas" />
                                        <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource CaptionMutedStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="8" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Delete this session" AutomationProperties.Name="Delete session">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="10" MaxWidth="280">
                                                <TextBlock TextWrapping="Wrap" Text="Delete this session's saved transcript and answers? This cannot be undone." />
                                                <Button Style="{StaticResource AccentButtonStyle}" Content="Delete" Tag="{x:Bind}" Click="ConfirmDelete_Click" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Grid.Row="1" Margin="0,24" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
