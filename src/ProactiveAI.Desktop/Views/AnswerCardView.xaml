<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ProactiveAI.Desktop.Views.AnswerCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProactiveAI.Desktop.Views">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sticky header: state and actions stay visible while reading -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusChipStyle}" Margin="0" Padding="8,2,10,2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind local:Ui.SeverityBrush(Card.StateSeverity), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Card.KindText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="·" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Card.StateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{x:Bind Card.TimeText, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" ToolTipService.ToolTip="Copy" AutomationProperties.Name="Copy answer"
                        Command="{x:Bind Host.CopyCommand, Mode=OneWay}" CommandParameter="{x:Bind Card, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" ToolTipService.ToolTip="{x:Bind Card.PinLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind Card.PinLabel, Mode=OneWay}"
                        Command="{x:Bind Host.TogglePinCommand, Mode=OneWay}" CommandParameter="{x:Bind Card, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind Card.PinGlyph, Mode=OneWay}" FontSize="14" />
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" ToolTipService.ToolTip="Show evidence in transcript" AutomationProperties.Name="Show evidence"
                        Command="{x:Bind Host.ShowEvidenceCommand, Mode=OneWay}" CommandParameter="{x:Bind Card, Mode=OneWay}" Visibility="{x:Bind local:Ui.Collapsed(Compact), Mode=OneWay}">
                    <FontIcon Glyph="&#xE7E6;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" ToolTipService.ToolTip="Stop generating" AutomationProperties.Name="Stop generating"
                        Command="{x:Bind Host.CancelCommand, Mode=OneWay}" CommandParameter="{x:Bind Card, Mode=OneWay}" Visibility="{x:Bind Card.CancelVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" ToolTipService.ToolTip="Regenerate" AutomationProperties.Name="Regenerate answer"
                        Command="{x:Bind Host.RegenerateCommand, Mode=OneWay}" CommandParameter="{x:Bind Card, Mode=OneWay}" Visibility="{x:Bind Card.RegenerateVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss answer"
                        Command="{x:Bind Host.DismissCommand, Mode=OneWay}" CommandParameter="{x:Bind Card, Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                      ViewChanged="Scroller_ViewChanged" PointerWheelChanged="Scroller_PointerWheelChanged">
            <StackPanel Spacing="10" Padding="0,0,14,12">
                <TextBlock Text="{x:Bind Card.QuestionText, Mode=OneWay}" Visibility="{x:Bind Card.QuestionVisibility, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" FontSize="{x:Bind QuestionFontSize, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Card.MetaText, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" />
                <Border Visibility="{x:Bind Card.StatusVisibility, Mode=OneWay}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10,6">
                    <TextBlock Text="{x:Bind Card.StatusDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                </Border>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Card.WaitingVisibility, Mode=OneWay}" />

                <TextBlock Text="{x:Bind Card.DirectPosition, Mode=OneWay}" Visibility="{x:Bind Card.DirectVisibility, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="{x:Bind BodyFontSize, Mode=OneWay}" LineHeight="{x:Bind LineHeight, Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Card.SpokenAnswer, Mode=OneWay}" Visibility="{x:Bind Card.SpokenVisibility, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}" FontSize="{x:Bind BodyFontSize, Mode=OneWay}" LineHeight="{x:Bind LineHeight, Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Border Visibility="{x:Bind Card.FilledInVisibility, Mode=OneWay}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="4" Padding="10,8" AutomationProperties.Name="Details the AI filled in">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="AI filled in — not from your notes or what you said. Check before saying:" Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Card.FilledInText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind Card.GeneratingVisibility, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind Card.IsGenerating, Mode=OneWay}" Width="14" Height="14" />
                    <TextBlock Text="Draft — still generating" Style="{StaticResource CaptionMutedStyle}" />
                </StackPanel>

                <TextBlock Text="{x:Bind Card.Suggestion, Mode=OneWay}" Visibility="{x:Bind Card.SuggestionVisibility, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <StackPanel Visibility="{x:Bind Card.SuggestedQuestionVisibility, Mode=OneWay}" Spacing="2">
                    <TextBlock Text="You could ask" Style="{StaticResource CaptionMutedStyle}" />
                    <TextBlock Text="{x:Bind Card.SuggestedQuestion, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>

                <Expander Header="Facts that must not be made up — add them yourself" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{x:Bind Card.MissingFactsVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.MissingFactsText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Expander>
                <Expander Header="Support and evidence" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{x:Bind Card.SupportingVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.SupportingText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Expander>
                <Expander Header="Assumptions and limits" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{x:Bind Card.LimitsVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.LimitsText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Expander>
                <Expander Header="Likely follow-ups" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{x:Bind Card.FollowupsVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.FollowupsText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Expander>
                <TextBlock Style="{StaticResource CaptionMutedStyle}" Margin="0,4,0,0"
                           Text="AI-generated draft for you to adapt. It may contain mistakes; facts are not externally verified." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
