<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ProactiveAI.Desktop.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ProactiveAI.Desktop.Views"
    Title="Proactive AI overlay">

    <Grid x:Name="Root" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
          PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragRegion" Height="36" Padding="12,0,8,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#7C3AED" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="HeaderText" Text="Proactive AI" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2,4,0">
                <Button x:Name="NewerButton" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Click="Newer_Click" Visibility="Collapsed"
                        ToolTipService.ToolTip="Show the newest answer" AutomationProperties.Name="Show newest answer">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="New question" Style="{StaticResource CaptionTextBlockStyle}" />
                        <FontIcon Glyph="&#xE72A;" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" Click="OpenMain_Click" ToolTipService.ToolTip="Open main window" AutomationProperties.Name="Open main window">
                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" Click="Hide_Click" ToolTipService.ToolTip="Hide until the next answer" AutomationProperties.Name="Hide overlay">
                    <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="14,0,6,10">
            <views:AnswerCardView x:Name="AnswerView" Compact="True" />
            <StackPanel x:Name="InsightView" Spacing="6" Visibility="Collapsed" Padding="0,0,8,0">
                <TextBlock x:Name="InsightTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="InsightBody" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="InsightQuestion" TextWrapping="Wrap" FontStyle="Italic" IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Button Content="Copy" Click="InsightCopy_Click" />
                    <Button Content="Dismiss" Click="InsightDismiss_Click" />
                    <Button Content="Show in app" Click="OpenMain_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
