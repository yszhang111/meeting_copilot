<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>ProactiveAI.Probe</RootNamespace>
    <AssemblyName>ProactiveAI.Probe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProactiveAI.Core\ProactiveAI.Core.csproj" />
    <ProjectReference Include="..\..\src\ProactiveAI.Infrastructure\ProactiveAI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\ProactiveAI.Tests\Fixtures\quality\*.json" Link="Fixtures\quality\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
