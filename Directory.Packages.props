<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Hosting / logging -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
    <!-- Audio -->
    <PackageVersion Include="NAudio.Core" Version="3.2.0" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.2.0" />
    <PackageVersion Include="NAudio.WinMM" Version="3.2.0" />
    <!-- Token counting -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
    <!-- Résumé text extraction (PDF) -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>
